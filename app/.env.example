# ============================================================
# EMSA — Environment Variables Template
# Copy to .env (in this app/ folder) and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# ----- PostgreSQL -----
DB_NAME=emsa
DB_USER=emsa_user
DB_PASSWORD=CHANGE_ME_strong_db_password

# ----- JWT for officer logins (at least 32 random characters) -----
JWT_SECRET=CHANGE_ME_minimum_32_chars_long_random_secret

# ----- Naloxone privacy: delete fulfilled requests after this many days -----
NALOXONE_RETENTION_DAYS=30

# ----- Port the site is served on (http://localhost:HTTP_PORT) -----
HTTP_PORT=80
